; Generated suite-level Cadence import.
load("eda_harness_api.il")

let((pdkPath lib workDir exportDir cdsText suiteCell maestroView sess
     expectedTests actualTests allTests generatedCornerAssignments
     assignment cornerName applicableTests disabledTests existingTest
     expectedTest actualTest)
  pdkPath = ehRequiredEnv("PDK_PATH")
  lib = ehRequiredEnv("CADENCE_LIB")
  workDir = ehRequiredEnv("CADENCE_WORKDIR")
  exportDir = getWorkingDir()
  cdsText = "cdsTextTo5x"
  suiteCell = "{{SUITE_CELL}}"
  maestroView = "maestro"
  expectedTests = {{EXPECTED_TESTS}}
  actualTests = nil
  generatedCornerAssignments = nil

  ehCreateManagedLibrary(lib workDir)

  ; Recreate the suite-level Maestro view once, before adding group tests.
  when(ddGetObj(lib suiteCell maestroView)
    ddDeleteObj(ddGetObj(lib suiteCell maestroView))
  )
  sess = maeOpenSetup(lib suiteCell maestroView ?mode "a" ?allowADEXL t)
  unless(sess error("maeOpenSetup failed: %s/%s/%s\n" lib suiteCell maestroView))

  ; Each generated block imports one fixture into unique spectre_<group> and
  ; config_<group> views, then creates one or more declared tests through eh*.
{{GROUP_BLOCKS}}

  ; Limit each group-prefixed corner to its registered tests.
  allTests = maeGetSetup(
    ?typeName "tests"
    ?session sess
  )

  foreach(assignment generatedCornerAssignments
    cornerName = car(assignment)
    applicableTests = cadr(assignment)
    disabledTests = nil

    foreach(existingTest allTests
      unless(member(existingTest applicableTests)
        disabledTests = cons(existingTest disabledTests)
      )
    )

    maeSetCorner(
      cornerName
      ?enabled t
      ?disableTests disabledTests
      ?session sess
    )
  )

  ; Compare the exact declared and actual test sets in both directions.
  actualTests = maeGetSetup(
    ?typeName "tests"
    ?session sess
  )

  foreach(expectedTest expectedTests
    unless(member(expectedTest actualTests)
      error("missing Maestro test: %s\n" expectedTest)
    )
  )

  foreach(actualTest actualTests
    unless(member(actualTest expectedTests)
      error("unexpected Maestro test: %s\n" actualTest)
    )
  )

  maeSaveSetup(
    ?lib lib
    ?cell suiteCell
    ?view maestroView
    ?session sess
  )

  ehWriteValidation(
    strcat(exportDir "/validation.json")
    length(expectedTests)
    length(actualTests)
  )

  printf(
    "EDA_HARNESS_EXPORT_OK tests=%d\n"
    length(actualTests)
  )

  maeCloseSession(
    ?session sess
  )
)

exit()
