    1: def _init_sky130_install() -> None:
    1:     if sky130.install is not None:
               return
    2:     sky130.install = sky130.Install(
    1:         pdk_path=Path("pdks/sky130A/sky130A").resolve(),
    1:         lib_path=Path("libs.tech/ngspice/sky130.lib.spice"),
    1:         model_ref=Path("libs.ref/sky130_fd_pr/spice"),
           )
       
       
    1: def _load_module(component_name: str):
   90:     return importlib.import_module(COMPONENT_SPECS[component_name]["module"])
       
       
    1: def _params_cls(component_name: str):
   36:     spec = COMPONENT_SPECS[component_name]
   36:     module = _load_module(component_name)
   36:     return getattr(module, spec["params"])
       
       
    1: def _dut_params(component_name: str, **kwargs):
   36:     return _params_cls(component_name)(**kwargs)
       
       
    1: def _builder_corner(component_name: str):
   13:     return "TT" if component_name in {"sample_hold_cap", "nonoverlap_clk"} else h.pdk.Corner.TYP
       
       
    1: def _registry_rows() -> list[dict[str, str]]:
    2:     with (ROOT / "components.csv").open() as f:
    1:         return list(csv.DictReader(f))
       
       
    2: class TestComponentLibraryContractCoverage(unittest.TestCase):
    1:     @classmethod
    1:     def setUpClass(cls) -> None:
