  159:             for builder_name, builder in inspect.getmembers(module, inspect.isfunction):
  150:                 if not builder_name.startswith("build_"):
  137:                     continue
   26:                 with self.subTest(component=component_name, builder=builder_name):
   13:                     sim = builder(params, corner=_builder_corner(component_name))
   13:                     self.assertEqual(list(sim.tb.ports), ["VSS"])
       
    1:     def test_component_library__contract__export_spice_creates_valid_netlists(self) -> None:
   10:         for component_name in COMPONENT_SPECS:
   18:             with self.subTest(component=component_name):
    9:                 module = _load_module(component_name)
    9:                 out_path = TMP_ROOT / f"{component_name}.sp"
    9:                 exported = module.export_spice(out_path, _dut_params(component_name))
    9:                 text = exported.read_text()
    9:                 subckt_name = extract_subckt_name(text)
       
    9:                 self.assertEqual(exported, out_path)
    9:                 self.assertTrue(exported.exists())
    9:                 self.assertTrue(subckt_name)
    9:                 self.assertIn(".SUBCKT", text)
    9:                 self.assertIn(".ENDS", text)
       
    1:     def test_component_library__contract__variant_topologies_export_expected_markers(self) -> None:
