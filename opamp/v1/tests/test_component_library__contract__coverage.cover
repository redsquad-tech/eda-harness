    1:         _init_sky130_install()
       
    1:     def test_component_library__contract__registry_matches_modules_and_params(self) -> None:
   11:         registry = {row["name"]: row for row in _registry_rows()}
    1:         self.assertEqual(set(registry), set(COMPONENT_SPECS))
       
   10:         for component_name, spec in COMPONENT_SPECS.items():
   18:             with self.subTest(component=component_name):
    9:                 module = _load_module(component_name)
    9:                 params_cls = getattr(module, spec["params"])
       
    9:                 self.assertTrue(hasattr(module, spec["generator"]))
    9:                 self.assertEqual(list(params_cls.__dataclass_fields__), spec["csv_params"])
    9:                 self.assertEqual(registry[component_name]["parameters"].split(","), spec["csv_params"])
       
    1:     def test_component_library__contract__verification_plan_schema(self) -> None:
    1:         required_keys = {"test", "analysis", "metrics", "rule", "corners", "sweeps", "monte_carlo"}
   10:         for component_name in COMPONENT_SPECS:
   18:             with self.subTest(component=component_name):
    9:                 module = _load_module(component_name)
    9:                 plan = module.VERIFICATION_PLAN
    9:                 self.assertIn("structural", plan)
   34:                 for test_name, payload in plan.items():
   25:                     self.assertEqual(set(payload), required_keys)
   25:                     self.assertTrue(callable(getattr(module, payload["test"])))
   25:                     self.assertIsInstance(payload["metrics"], list)
   25:                     self.assertIsInstance(payload["corners"], list)
   25:                     self.assertIsInstance(payload["sweeps"], list)
   25:                     self.assertIsInstance(payload["monte_carlo"], bool)
   25:                     self.assertIsInstance(test_name, str)
       
