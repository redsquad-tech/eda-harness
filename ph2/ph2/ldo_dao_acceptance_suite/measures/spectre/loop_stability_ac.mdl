// LDO_DAO SpectreMDL checks for loop_stability_ac.
alias measurement loop_stability_check {
  run ac1

  export real GBW_Hz
  export real PM_deg
  export real GM_dB
  export real fail_count
  export real pass

  GBW_Hz = cross(sig=db(-V(vfb_o)/V(vfb_i)), dir='fall, n=1, thresh=0)
  PM_deg = phasemargin(-V(vfb_o)/V(vfb_i))
  GM_dB = gainmargin(-V(vfb_o)/V(vfb_i))

  fail_count = 0
  pass = 1

  print fmt("BEGIN suite=loop_stability_ac simulator=spectre corner=%s temp_c=%g vdd=%g\n", "@CORNER@", @TEMP_C@, @VDD@) to="spectre_results.txt"

  if (GBW_Hz < 100e3) {
    print fmt("FAIL test=loop_stability_ac reason=GBW_LOW simulator=spectre corner=%s temp_c=%g vdd=%g GBW_Hz=%g limit_min_Hz=100000\n", "@CORNER@", @TEMP_C@, @VDD@, GBW_Hz) addto="spectre_results.txt"
    fail_count = fail_count + 1
    pass = 0
  }
  if (PM_deg < 40) {
    print fmt("FAIL test=loop_stability_ac reason=PM_LOW simulator=spectre corner=%s temp_c=%g vdd=%g PM_deg=%g limit_min_deg=40\n", "@CORNER@", @TEMP_C@, @VDD@, PM_deg) addto="spectre_results.txt"
    fail_count = fail_count + 1
    pass = 0
  }
  if (GM_dB < 20) {
    print fmt("FAIL test=loop_stability_ac reason=GM_LOW simulator=spectre corner=%s temp_c=%g vdd=%g GM_dB=%g limit_min_dB=20\n", "@CORNER@", @TEMP_C@, @VDD@, GM_dB) addto="spectre_results.txt"
    fail_count = fail_count + 1
    pass = 0
  }

  print fmt("RESULT test=loop_stability_ac simulator=spectre corner=%s temp_c=%g vdd=%g GBW_Hz=%g PM_deg=%g GM_dB=%g pass=%g\n", "@CORNER@", @TEMP_C@, @VDD@, GBW_Hz, PM_deg, GM_dB, pass) addto="spectre_results.txt"
  print fmt("SUMMARY suite=loop_stability_ac simulator=spectre runs=1 fail_count=%g\n", fail_count) addto="spectre_results.txt"
}

run loop_stability_check
