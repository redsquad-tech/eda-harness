.control
set noaskquit
set numdgt=12
unset appendwrite

let run_index = 0
let fail_count = 0

echo BEGIN suite=psrr_ac simulator=ngspice

foreach temp_c -40 27 150
  foreach vdd_v 2.0 3.3 3.6
    let run_index = run_index + 1
    alterparam TB_VDD = $vdd_v
    alterparam TB_VREF = 0.80
    alterparam TB_IBIAS = 400n
    reset
    set temp=$temp_c
    ac dec 200 1 1e9

    let ratio = v(vout_1v2)/v(vdd_3v3)
    let psrr_db = -vdb(ratio)
    let vout_over_vdd_db = vdb(ratio)
    meas ac psrr_min MIN psrr_db

    let pass_code = 1
    let run_x = run_index
    let temp_num = $temp_c
    let vdd_num = $vdd_v

    if psrr_min < 40
      echo FAIL test=psrr_ac reason=PSRR_LOW temp_c=$temp_c vdd=$vdd_v PSRR_min_dB=$&psrr_min limit_min_dB=40
      let pass_code = 0
      let fail_count = fail_count + 1
    end

    echo RESULT test=psrr_ac temp_c=$temp_c vdd=$vdd_v PSRR_min_dB=$&psrr_min pass=$&pass_code
    let temp_vec = frequency*0 + temp_num
    let vdd_vec = frequency*0 + vdd_num
    setscale frequency
    wrdata psrr_waveforms.dat temp_vec vdd_vec psrr_db vout_over_vdd_db
    setscale run_x
    wrdata psrr_metrics.dat temp_num vdd_num psrr_min pass_code
    set appendwrite
    destroy $curplot
  end
end

echo SUMMARY suite=psrr_ac runs=$&run_index fail_count=$&fail_count
if fail_count > 0
  quit 1
else
  quit 0
end
.endc
