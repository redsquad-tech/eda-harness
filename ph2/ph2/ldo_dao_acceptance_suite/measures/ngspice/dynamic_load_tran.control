.control
set noaskquit
set numdgt=12
unset appendwrite

let run_index = 0
let fail_count = 0

echo BEGIN suite=dynamic_load_tran simulator=ngspice

foreach temp_c -40 27 150
  foreach vdd_v 2.0 3.3 3.6
    let run_index = run_index + 1
    alterparam TB_VDD = $vdd_v
    alterparam TB_VREF = 0.80
    alterparam TB_IBIAS = 400n
    alterparam TB_ILOAD_DC = 15u
    alterparam TB_ILOAD_PULSE = 30m
    alterparam TB_TSTART = 200n
    alterparam TB_TPW = 200p
    alterparam TB_TPER = 100n
    reset
    set temp=$temp_c
    tran 10p 900n

    let npts = length(time)
    let last_idx = npts - 1
    let tran_stop_s = time[last_idx]

    if tran_stop_s < 899n
      let pass_code = 0
      let run_x = run_index
      let temp_num = $temp_c
      let fail_count = fail_count + 1
      echo FAIL test=dynamic_load_tran reason=TRAN_NOT_COMPLETED temp_c=$temp_c vdd=$vdd_v simulation_status=not_completed tran_stop_s=$&tran_stop_s limit_min_s=8.99e-7
      echo RESULT test=dynamic_load_tran temp_c=$temp_c vdd=$vdd_v simulation_status=not_completed tran_stop_s=$&tran_stop_s pass=$&pass_code
      setscale run_x
      wrdata dynamic_load_metrics.dat temp_num tran_stop_s pass_code
      set appendwrite
    else
      meas tran vout_pre AVG v(vout_1v2) FROM=150n TO=190n
      meas tran vout_min MIN v(vout_1v2) FROM=200n TO=400n
      meas tran vout_max MAX v(vout_1v2) FROM=200n TO=400n
      meas tran vout_dyn_avg AVG v(vout_1v2) FROM=400n TO=900n

      let drop_mV = 1000*(vout_pre - vout_min)
      if drop_mV < 0
        let drop_mV = 0
      end
      let overshoot_mV = 1000*(vout_max - vout_pre)
      if overshoot_mV < 0
        let overshoot_mV = 0
      end
      let avg_drop_mV = 1000*(vout_pre - vout_dyn_avg)
      if avg_drop_mV < 0
        let avg_drop_mV = 0
      end

      let pass_code = 1
      let run_x = run_index
      let temp_num = $temp_c
      let vdd_num = $vdd_v

      if vout_pre < 1.08
        echo FAIL test=dynamic_load_tran reason=PRE_VOUT_LOW temp_c=$temp_c vdd=$vdd_v Vout_pre_V=$&vout_pre limit_min_V=1.08
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if vout_pre > 1.32
        echo FAIL test=dynamic_load_tran reason=PRE_VOUT_HIGH temp_c=$temp_c vdd=$vdd_v Vout_pre_V=$&vout_pre limit_max_V=1.32
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if vout_min < 0.5
        echo FAIL test=dynamic_load_tran reason=VOUT_MIN_UNPHYSICAL temp_c=$temp_c vdd=$vdd_v Vout_min_V=$&vout_min limit_min_V=0.5
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if vout_dyn_avg < 1.055
        echo FAIL test=dynamic_load_tran reason=AVG_VOUT_LOW temp_c=$temp_c vdd=$vdd_v Vout_dyn_avg_V=$&vout_dyn_avg limit_min_V=1.055
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if drop_mV > 50
        echo FAIL test=dynamic_load_tran reason=DROP_HIGH temp_c=$temp_c vdd=$vdd_v drop_mV=$&drop_mV limit_max_mV=50
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if overshoot_mV > 20
        echo FAIL test=dynamic_load_tran reason=OVERSHOOT_HIGH temp_c=$temp_c vdd=$vdd_v overshoot_mV=$&overshoot_mV limit_max_mV=20
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if avg_drop_mV > 25
        echo FAIL test=dynamic_load_tran reason=AVG_DROP_HIGH temp_c=$temp_c vdd=$vdd_v avg_drop_mV=$&avg_drop_mV limit_max_mV=25
        let pass_code = 0
        let fail_count = fail_count + 1
      end

      echo RESULT test=dynamic_load_tran temp_c=$temp_c vdd=$vdd_v Vout_pre_V=$&vout_pre Vout_min_V=$&vout_min Vout_max_V=$&vout_max Vout_dyn_avg_V=$&vout_dyn_avg drop_mV=$&drop_mV overshoot_mV=$&overshoot_mV avg_drop_mV=$&avg_drop_mV pass=$&pass_code
      let temp_vec = time*0 + temp_num
      let vdd_vec = time*0 + vdd_num
      let vout_wave = v(vout_1v2)
      let gate_wave = v(gate_dyn)
      let iin_total_uA = -1e6*i(V_VDD)
      let load_total_mA = 1000*(15u + 30m*v(gate_dyn))
      setscale time
      wrdata dynamic_load_waveforms.dat temp_vec vdd_vec vout_wave gate_wave iin_total_uA load_total_mA
      setscale run_x
      wrdata dynamic_load_metrics.dat temp_num vout_pre vout_min vout_max vout_dyn_avg drop_mV overshoot_mV avg_drop_mV pass_code
      set appendwrite
    end
    destroy $curplot
  end
end

echo SUMMARY suite=dynamic_load_tran runs=$&run_index fail_count=$&fail_count
if fail_count > 0
  quit 1
else
  quit 0
end
.endc
