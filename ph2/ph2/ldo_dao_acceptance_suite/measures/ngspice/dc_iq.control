.control
set noaskquit
set numdgt=12
unset appendwrite

let run_index = 0
let fail_count = 0

echo BEGIN suite=dc_iq simulator=ngspice

foreach temp_c -40 27 150
  foreach vdd_v 2.0 3.3 3.6
    foreach iload_a 0 15e-6
      let run_index = run_index + 1
      alterparam TB_VDD = $vdd_v
      alterparam TB_VREF = 0.80
      alterparam TB_IBIAS = 400n
      alterparam TB_ILOAD_DC = $iload_a
      reset
      set temp=$temp_c
      op

      let vout_v = v(vout_1v2)
      let iin_total_uA = -1e6*i(V_VDD)
      let iq_uA = iin_total_uA - 1e6*$iload_a
      let pass_code = 1
      let run_x = run_index
      let temp_num = $temp_c
      let vdd_num = $vdd_v
      let vref_num = 0.80
      let ibias_A = 400e-9
      let iload_A = $iload_a
      let no_load_case = run_index - 2*floor(run_index/2)

      if vout_v < 1.08
        echo FAIL test=dc_iq reason=VOUT_LOW sweep=PVT temp_c=$temp_c vdd=$vdd_v vref=0.80 ibias_A=400e-9 iload_A=$&iload_A value_V=$&vout_v limit_min_V=1.08
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if vout_v > 1.32
        echo FAIL test=dc_iq reason=VOUT_HIGH sweep=PVT temp_c=$temp_c vdd=$vdd_v vref=0.80 ibias_A=400e-9 iload_A=$&iload_A value_V=$&vout_v limit_max_V=1.32
        let pass_code = 0
        let fail_count = fail_count + 1
      end
      if no_load_case > 0.5
        if iq_uA > 3.0
          echo FAIL test=dc_iq reason=IQ_HIGH sweep=PVT temp_c=$temp_c vdd=$vdd_v vref=0.80 ibias_A=400e-9 iload_A=$&iload_A value_uA=$&iq_uA limit_max_uA=3.0
          let pass_code = 0
          let fail_count = fail_count + 1
        end
      end

      echo RESULT test=dc_iq sweep=PVT temp_c=$temp_c vdd=$vdd_v vref=0.80 ibias_A=400e-9 iload_A=$&iload_A Vout_V=$&vout_v Iin_total_uA=$&iin_total_uA Iq_uA=$&iq_uA pass=$&pass_code
      setscale run_x
      wrdata dc_iq_metrics.dat temp_num vdd_num vref_num ibias_A iload_A vout_v iin_total_uA iq_uA pass_code
      set appendwrite
      destroy $curplot
    end
  end
end

foreach vref_v 0.72 0.88
  foreach iload_a 0 15e-6
    let run_index = run_index + 1
    alterparam TB_VDD = 3.3
    alterparam TB_VREF = $vref_v
    alterparam TB_IBIAS = 400n
    alterparam TB_ILOAD_DC = $iload_a
    reset
    set temp=27
    op

    let vout_v = v(vout_1v2)
    let iin_total_uA = -1e6*i(V_VDD)
    let iq_uA = iin_total_uA - 1e6*$iload_a
    let pass_code = 1
    let run_x = run_index
    let temp_num = 27
    let vdd_num = 3.3
    let vref_num = $vref_v
    let ibias_A = 400e-9
    let iload_A = $iload_a
    let no_load_case = run_index - 2*floor(run_index/2)

    if vout_v < 1.08
      echo FAIL test=dc_iq reason=VOUT_LOW sweep=VREF temp_c=27 vdd=3.3 vref=$vref_v ibias_A=400e-9 iload_A=$&iload_A value_V=$&vout_v limit_min_V=1.08
      let pass_code = 0
      let fail_count = fail_count + 1
    end
    if vout_v > 1.32
      echo FAIL test=dc_iq reason=VOUT_HIGH sweep=VREF temp_c=27 vdd=3.3 vref=$vref_v ibias_A=400e-9 iload_A=$&iload_A value_V=$&vout_v limit_max_V=1.32
      let pass_code = 0
      let fail_count = fail_count + 1
    end
    if no_load_case > 0.5
      if iq_uA > 3.0
        echo FAIL test=dc_iq reason=IQ_HIGH sweep=VREF temp_c=27 vdd=3.3 vref=$vref_v ibias_A=400e-9 iload_A=$&iload_A value_uA=$&iq_uA limit_max_uA=3.0
        let pass_code = 0
        let fail_count = fail_count + 1
      end
    end

    echo RESULT test=dc_iq sweep=VREF temp_c=27 vdd=3.3 vref=$vref_v ibias_A=400e-9 iload_A=$&iload_A Vout_V=$&vout_v Iin_total_uA=$&iin_total_uA Iq_uA=$&iq_uA pass=$&pass_code
    setscale run_x
    wrdata dc_iq_metrics.dat temp_num vdd_num vref_num ibias_A iload_A vout_v iin_total_uA iq_uA pass_code
    set appendwrite
    destroy $curplot
  end
end

foreach ibias_a 300n 500n
  foreach iload_a 0 15e-6
    let run_index = run_index + 1
    alterparam TB_VDD = 3.3
    alterparam TB_VREF = 0.80
    alterparam TB_IBIAS = $ibias_a
    alterparam TB_ILOAD_DC = $iload_a
    reset
    set temp=27
    op

    let vout_v = v(vout_1v2)
    let iin_total_uA = -1e6*i(V_VDD)
    let iq_uA = iin_total_uA - 1e6*$iload_a
    let pass_code = 1
    let run_x = run_index
    let temp_num = 27
    let vdd_num = 3.3
    let vref_num = 0.80
    let ibias_A = $ibias_a
    let iload_A = $iload_a
    let no_load_case = run_index - 2*floor(run_index/2)

    if vout_v < 1.08
      echo FAIL test=dc_iq reason=VOUT_LOW sweep=IBIAS temp_c=27 vdd=3.3 vref=0.80 ibias_A=$&ibias_A iload_A=$&iload_A value_V=$&vout_v limit_min_V=1.08
      let pass_code = 0
      let fail_count = fail_count + 1
    end
    if vout_v > 1.32
      echo FAIL test=dc_iq reason=VOUT_HIGH sweep=IBIAS temp_c=27 vdd=3.3 vref=0.80 ibias_A=$&ibias_A iload_A=$&iload_A value_V=$&vout_v limit_max_V=1.32
      let pass_code = 0
      let fail_count = fail_count + 1
    end
    if no_load_case > 0.5
      if iq_uA > 3.0
        echo FAIL test=dc_iq reason=IQ_HIGH sweep=IBIAS temp_c=27 vdd=3.3 vref=0.80 ibias_A=$&ibias_A iload_A=$&iload_A value_uA=$&iq_uA limit_max_uA=3.0
        let pass_code = 0
        let fail_count = fail_count + 1
      end
    end

    echo RESULT test=dc_iq sweep=IBIAS temp_c=27 vdd=3.3 vref=0.80 ibias_A=$&ibias_A iload_A=$&iload_A Vout_V=$&vout_v Iin_total_uA=$&iin_total_uA Iq_uA=$&iq_uA pass=$&pass_code
    setscale run_x
    wrdata dc_iq_metrics.dat temp_num vdd_num vref_num ibias_A iload_A vout_v iin_total_uA iq_uA pass_code
    set appendwrite
    destroy $curplot
  end
end

echo SUMMARY suite=dc_iq runs=$&run_index fail_count=$&fail_count
if fail_count > 0
  quit 1
else
  quit 0
end
.endc
