# Choose simulator: auto, spectre, or ngspice.
export LDO_DAO_SIMULATOR=spectre

# DUT under test.
export LDO_DAO_DUT_NETLIST=/abs/path/to/ldo_dao.spi
export LDO_DAO_DUT_SUBCKT=ldo_dao
export LDO_DAO_DUT_STYLE=spice

# Model setup. For Cadence/Spectre PDKs this is often spectre + section=corner.
export LDO_DAO_MODEL_LIB=/abs/path/to/models.scs
export LDO_DAO_MODEL_STYLE=spectre

# Optional extra include files, whitespace-separated.
# export LDO_DAO_MODEL_INCLUDE="/abs/path/to/extra_1.scs /abs/path/to/extra_2.scs"
# export LDO_DAO_MODEL_INCLUDE_STYLE=spectre

# Logical acceptance corners. Map names if PDK section names are different.
export LDO_DAO_CORNERS="typical fff ssf fsf sff"
export LDO_DAO_CORNER_MAP="typical:tt fff:ff ssf:ss fsf:fs sff:sf"

# Optional simulator binary overrides.
# export LDO_DAO_SPECTRE_MDL=/path/to/spectremdl
# export LDO_DAO_NGSPICE=/path/to/ngspice

# Optional test selection.
# export LDO_DAO_TESTS="dc_iq dynamic_load_tran psrr_ac loop_stability_ac"
# export LDO_DAO_TESTS="all"
