let((group lib cell spectreView configView maestroView testName
      fixtureSp dutNetlist supportDir dutSupport wrapperDeck libPath
      in out line inTop cwd cmd status cfg sess db
      processes temps cases proc temp case corner cornerName corners cornerCount
      cornerHandle model)

  ; Block 1: names and source files.
  ; Keep all generated Cadence objects named from one testbench group.
  group = "{{GROUP}}"
  lib = "{{LIBRARY}}"
  cell = "{{CELL}}"
  spectreView = strcat("spectre_" group)
  configView = "config"
  maestroView = "maestro"
  testName = group

  fixtureSp = strcat("tests/" group ".sp")
  dutNetlist = "{{DUT_NETLIST}}"
  supportDir = "cadence_export/generated_support"
  dutSupport = strcat(supportDir "/cadence_dut.scs")
  wrapperDeck = strcat(supportDir "/" group ".scs")
  libPath = strcat("cadence_export/" lib)

  unless(isFile(fixtureSp) error("missing fixture SPICE: %s\n" fixtureSp))
  unless(isFile(dutNetlist) error("missing original DUT netlist: %s\n" dutNetlist))

  ; Block 2: Cadence library.
  ; Create one generated library for the acceptance suite.
  system("mkdir -p cadence_export")
  unless(ddGetObj(lib)
    ddCreateLib(lib libPath)
  )
  unless(ddGetObj(lib) error("failed to create Cadence library: %s\n" lib))

  ; Block 3: Cadence DUT support deck.
  ; Preserve the original Spectre DUT text and expose the public DUT subckt.
  system(strcat("mkdir -p " supportDir))
  in = infile(dutNetlist)
  out = outfile(dutSupport "w")
  unless(in error("failed to open DUT netlist: %s\n" dutNetlist))
  unless(out error("failed to write DUT support: %s\n" dutSupport))

  inTop = nil
  while(gets(line in)
    if(rexMatchp("{{DUT_BODY_MARKER}}" line) then
      inTop = t
      fprintf(out "%s" line)
      fprintf(out "subckt {{DUT_SUBCKT}} {{DUT_PINS}}\n")
    else
      fprintf(out "%s" line)
    )
  )
  when(inTop
    fprintf(out "ends {{DUT_SUBCKT}}\n")
  )
  close(in)
  close(out)
  unless(inTop error("failed to find DUT body marker in %s\n" dutNetlist))

  ; Block 4: importable Spectre/SPICE wrapper.
  ; Embed the fixture source so cdsTextTo5x can import its .SUBCKT as the cell.
  cwd = getWorkingDir()
  out = outfile(wrapperDeck "w")
  unless(out error("failed to write wrapper deck: %s\n" wrapperDeck))
  fprintf(out "simulator lang=spectre\n")
  fprintf(out "include \"%s/%s\"\n\n" cwd dutSupport)
  fprintf(out "simulator lang=spice\n")
  fprintf(out "* BEGIN embedded %s/%s\n" cwd fixtureSp)
  in = infile(fixtureSp)
  unless(in error("failed to open fixture SPICE: %s\n" fixtureSp))
  while(gets(line in)
    fprintf(out "%s" line)
  )
  close(in)
  fprintf(out "* END embedded %s/%s\n" cwd fixtureSp)
  fprintf(out "simulator lang=spectre\n")
  close(out)

  ; Block 5: Spectre text view import.
  ; Recreate the generated view from the wrapper deck.
  when(ddGetObj(lib cell spectreView)
    ddDeleteObj(ddGetObj(lib cell spectreView))
  )
  cmd = strcat(
    "cdsTextTo5x -CDSLIB cds.lib -LIB " lib
    " -CELL " cell
    " -VIEW " spectreView
    " -LANG spectre "
    wrapperDeck
  )
  status = system(cmd)
  unless(status == 0 error("cdsTextTo5x failed: %s\n" cmd))
  unless(ddGetObj(lib cell spectreView)
    error("imported view missing: %s/%s/%s\n" lib cell spectreView))

  ; Block 6: config view.
  ; Make simulations use the imported Spectre view directly.
  cfg = hdbOpen(lib cell configView "w" "CDBA")
  unless(cfg error("failed to open config view: %s/%s/%s\n" lib cell configView))
  hdbSetTopCellViewName(cfg lib cell spectreView)
  hdbSetDefaultViewListString(cfg strcat(spectreView " spectre schematic veriloga ahdl"))
  hdbSetDefaultStopListString(cfg strcat(spectreView " spectre"))
  hdbSave(cfg)
  hdbClose(cfg)

  ; Block 7: Maestro test.
  ; Create one ADE Assembler test that points at the config view.
  when(ddGetObj(lib cell maestroView)
    ddDeleteObj(ddGetObj(lib cell maestroView))
  )
  sess = maeOpenSetup(lib cell maestroView ?mode "a" ?allowADEXL t)
  unless(sess error("maeOpenSetup failed: %s/%s/%s\n" lib cell maestroView))
  maeCreateTest(testName ?lib lib ?cell cell ?view configView ?simulator "spectre" ?session sess)

  ; Block 8: nominal fixture variables.
  ; These are the public knobs used by the ngspice fixture.
{{TEST_LEVEL_TB_VARS}}

  ; Block 9: analysis, outputs, and limits.
  ; Keep analyses and checks in Maestro, not in the imported Spectre view.
{{ANALYSIS_OUTPUTS_SPECS}}

  ; Block 10: corners matrix.
  ; Each corner owns case variables, native simulator temperature, and model file setup.
  processes = list({{PROCESS_LIST}})
  temps = list({{TEMP_LIST}})
  cases = list(
{{CASE_LIST}}
  )

  corners = nil
  foreach(proc processes
    foreach(temp temps
      foreach(case cases
        cornerName = strcat(group "__" car(case) "__" proc "__temp_" temp)
        corners = cons(list(cornerName proc temp) corners)

        maeSetCorner(cornerName ?enableTests list(testName) ?enabled t ?session sess)
{{CORNER_TB_VAR_OVERRIDES}}
      )
    )
  )

  db = axlGetMainSetupDB(sess)
  unless(db error("axlGetMainSetupDB failed\n"))
  cornerCount = 0
  foreach(corner corners
    cornerName = car(corner)
    proc = cadr(corner)
    temp = caddr(corner)

    cornerHandle = axlGetCorner(db cornerName)
    unless(cornerHandle error("axlGetCorner failed: %s\n" cornerName))

    axlPutVar(cornerHandle "temperature" temp)
    model = axlPutModel(cornerHandle proc)
    unless(model error("axlPutModel failed: %s\n" cornerName))
    axlSetModelFile(model strcat("$LIB_PATH/" proc ".scs"))
    axlSetModelSection(model proc)
    axlSetModelTest(model testName)
    axlSetEnabled(model t)

    cornerCount = cornerCount + 1
  )

  ; Block 11: save the Maestro setup.
  ; One save at the end keeps the script shorter and avoids partial persisted state.
  maeSaveSetup(?lib lib ?cell cell ?view maestroView ?session sess)
  printf("generate PASS lib=%s cell=%s view=%s corners=%d\n" lib cell maestroView cornerCount)
)

exit()
